<div class="wrap">
    <h1>{{ page_title }}</h1>

    {% if saved is defined and saved %}
        <div class="notice notice-success is-dismissible">
            <p>{{ 'Warehouse saved successfully.'|trans }}</p>
        </div>
    {% endif %}

    {% if geocoding_failed %}
        <div class="notice notice-warning is-dismissible">
            <p>{{ 'Geocoding failed: the address could not be resolved to coordinates. The warehouse was saved without coordinates. Please verify the address format.'|trans }}</p>
            <p><em>{{ 'Tip: Use the format — Street Number, ZIP City, Country (e.g. Draškovićeva 80, 10000 Zagreb, Hrvatska)'|trans }}</em></p>
        </div>
    {% endif %}

    {% if deleted is defined and deleted %}
        <div class="notice notice-success is-dismissible">
            <p>{{ 'Warehouse deleted successfully.'|trans }}</p>
        </div>
    {% endif %}

    <a href="{{ add_url }}" class="page-title-action">{{ 'Add New Warehouse'|trans }}</a>

    <table class="wp-list-table widefat fixed striped">
        <thead>
            <tr>
                <th scope="col">{{ 'ID'|trans }}</th>
                <th scope="col">{{ 'Name'|trans }}</th>
                <th scope="col">{{ 'Address'|trans }}</th>
                <th scope="col">{{ 'Coordinates'|trans }}</th>
                <th scope="col">{{ 'Status'|trans }}</th>
                <th scope="col">{{ 'Extra Shipping Cost'|trans }}</th>
                <th scope="col">{{ 'Actions'|trans }}</th>
            </tr>
        </thead>
        <tbody>
            {% if warehouses is empty %}
                <tr>
                    <td colspan="7">{{ 'No warehouses found. Add your first warehouse above.'|trans }}</td>
                </tr>
            {% else %}
                {% for warehouse in warehouses %}
                    <tr>
                        <td>{{ warehouse.id }}</td>
                        <td><strong>{{ warehouse.name }}</strong></td>
                        <td>{{ warehouse.address }}</td>
                        <td>
                            {% if warehouse.hasCoordinates() %}
                                {{ warehouse.latitude|number_format(6) }}, {{ warehouse.longitude|number_format(6) }}
                            {% else %}
                                <em>{{ 'Not geocoded'|trans }}</em>
                            {% endif %}
                        </td>
                        <td>
                            {% if warehouse.isActive() %}
                                <span class="wdmw-status wdmw-status--active">{{ 'Active'|trans }}</span>
                            {% else %}
                                <span class="wdmw-status wdmw-status--inactive">{{ 'Inactive'|trans }}</span>
                            {% endif %}
                        </td>
                        <td>{{ warehouse.extraShippingCost|number_format(2) }}</td>
                        <td>
                            <a href="admin.php?page=wdmw-warehouses&action=edit&warehouse_id={{ warehouse.id }}"
                               class="button button-small">{{ 'Edit'|trans }}</a>

                            <form method="post" style="display: inline;" onsubmit="return confirm('{{ 'Are you sure you want to delete this warehouse?'|trans }}');">
                                {{ nonce|raw }}
                                <input type="hidden" name="wdmw_action" value="delete_warehouse">
                                <input type="hidden" name="warehouse_id" value="{{ warehouse.id }}">
                                <button type="submit" class="button button-small button-link-delete">{{ 'Delete'|trans }}</button>
                            </form>
                        </td>
                    </tr>
                {% endfor %}
            {% endif %}
        </tbody>
    </table>
</div>
